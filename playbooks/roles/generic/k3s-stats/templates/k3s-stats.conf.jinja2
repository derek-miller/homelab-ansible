[[inputs.kubernetes]]
  url = "https://127.0.0.1:10250"
  bearer_token = "{{ k3s_stats_token_path }}"
  tls_ca = "{{ k3s_stats_ca_path }}"
  namedrop = ["kubernetes_pod_volume"]
  # Flux pins every image to its digest, so this tag changes with each upgrade.
  tagexclude = ["image"]

[[inputs.kube_inventory]]
  # Never called, since pods come from url_kubelet, but the plugin won't start without it.
  url = "https://{{ k3s_server_address }}:6443"
  url_kubelet = "https://127.0.0.1:10250"
  bearer_token = "{{ k3s_stats_token_path }}"
  tls_ca = "{{ k3s_stats_ca_path }}"
  resource_include = ["pods"]
  # inputs.kubernetes already writes kubernetes_pod_container.
  name_override = "kubernetes_pod_container_status"
  [inputs.kube_inventory.tagdrop]
    condition = ["*"]
{% if k3s_role == 'server' %}

# Read once, on the server. Its absence means the API is down.
[[inputs.kube_inventory]]
  url = "https://{{ k3s_server_address }}:6443"
  bearer_token = "{{ k3s_stats_token_path }}"
  tls_ca = "{{ k3s_stats_ca_path }}"
  resource_include = ["nodes", "deployments", "statefulsets", "daemonsets"]
  # Every namespace, rather than only default.
  namespace = ""
  # inputs.kubernetes already writes kubernetes_node.
  name_suffix = "_status"

# k8up's verdict on each finished Backup, which fails when its backup command does.
[[inputs.http]]
  urls = ["https://{{ k3s_server_address }}:6443/apis/k8up.io/v1/backups"]
  token_file = "{{ k3s_stats_token_path }}"
  tls_ca = "{{ k3s_stats_ca_path }}"
  interval = "5m"
  tagexclude = ["url"]
  data_format = "json_v2"
  [[inputs.http.json_v2]]
    measurement_name = "kubernetes_backup_status"
    [[inputs.http.json_v2.object]]
      path = 'items.#(status.finished==true)#.{"namespace":metadata.namespace,"name":metadata.name,"reason":status.conditions.#(type=="Completed").reason,"completed":status.conditions.#(type=="Completed").lastTransitionTime}'
      tags = ["namespace", "name"]
      disable_prepend_keys = true
{% endif %}
