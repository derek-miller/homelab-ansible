[Unit]
Description=Proxmox LAN link watchdog
Documentation=https://youtrack.dmiller.me/issue/HL-24
# pve-cluster owns /etc/pve, which is where peers publish their LAN health.
After=pve-cluster.service network-online.target
Wants=network-online.target
Requires=pve-cluster.service

[Service]
Type=simple
EnvironmentFile=/etc/default/pve-lan-watchdog
ExecStart=/usr/local/sbin/pve-lan-watchdog
# It must come back on its own: the failure it exists to catch is exactly the
# window in which nobody is watching the hypervisor.
Restart=always
RestartSec=10
SyslogIdentifier=pve-lan-watchdog
# Needs ip link and ha-manager, so no sandboxing beyond the obvious.
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
