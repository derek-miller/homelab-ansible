{# PVE's parser requires a blank line between sections. Ansible renders templates
   with trim_blocks=True, which eats the newline immediately after a block tag, so
   each section emits its own leading blank line rather than a trailing one.

   Header values like {{ secrets.token }} are PVE's own templating, resolved from
   /etc/pve/priv/notifications.cfg. #}
{% for t in proxmox_notification_targets %}
{% if not loop.first %}

{% endif %}
webhook: {{ t.name }}
	body {{ lookup('file', t.body_file) | trim | b64encode }}
{% for name, value in t.headers | dictsort %}
	header name={{ name }},value={{ value | b64encode }}
{% endfor %}
	method {{ t.method | default('post') }}
	url {{ t.url }}
{% endfor %}
{% for m in proxmox_notification_matchers %}

matcher: {{ m.name }}
{% for k, v in m.items() if k != 'name' %}
	{{ k }} {{ v }}
{% endfor %}
{% endfor %}
