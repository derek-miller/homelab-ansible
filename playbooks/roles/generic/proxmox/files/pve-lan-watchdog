}


def notify(severity, event_name, node, detail_text):
    """Deliver one notification through PVE's own system, so it follows the
    matchers the cluster already routes (node-red -> Discord today). Runs only
    on the elected reporter, whose LAN is verified working by its own
    election, so the transport does not share fate with the fault being
    reported. Never fatal: a lost notification must not affect the watchdog."""
    if not NOTIFY_ENABLED:
        return
    payload = json.dumps(
        {
            "data": {"node": node, "event": event_name, "detail": detail_text, "reporter": NODE},
            "fields": {"type": "lan-watchdog", "hostname": node},
        }
    )
    rc, out = run(
        [
            "perl",
            "-MPVE::Notify",
            "-MJSON::PP",
            "-e",
            "my ($sev, $tmpl, $json) = @ARGV;"
            " my $p = JSON::PP::decode_json($json);"
            " PVE::Notify::notify($sev, $tmpl, $p->{data}, $p->{fields});",
            severity,
            NOTIFY_TEMPLATE,
            payload,
        ],
        timeout=20,
    )
    if rc != 0:
        log("err", "notification failed for %s/%s: %s" % (node, event_name, out))


def _raw(node, event):
    """An event this reporter cannot compose a message for: an unknown name,
    a non-string name, or a known name whose detail shape a newer node
    changed. The title is always a plain string, so the notification's event
    field never goes out as serialized JSON."""
    name = event.get("name")
    return (
        "warning",
        str(name) if name is not None else "unknown event",
        node,
        "%s reported '%s': %s" % (node, name, event.get("detail")),
    )


def report(docs, members, announced, now=None, unreadable=frozenset()):
    """The reporter's whole decision, as a pure function so it is testable
    without a clock, a cluster, or a subprocess: given every node's document,
    corosync's membership view, and a cursor of what has already been
    announced, return the notifications due and the updated cursor.

    announced: {node: {"seq": int, "stale_ts": int}} — seq is the last event
    sequence announced for that node; stale_ts is the document timestamp a
    staleness alert was last sent for, so one stall alerts once rather than
    every tick, and a recovery re-arms it."""
    now = int(now if now is not None else time.time())
    out = []
    for node, online in sorted(members.items()):
        # One node's unexpected bytes must not cost the others their
        # messages: out already holds them, and an unwind here would
        # discard it while their cursors have advanced. Rendering has its
        # own guard; this catches what nobody predicted.
        try:
            doc = docs.get(node)
            # The floor is what a reporter with no history should treat as already
            # announced: everything older than the freshness window. Applied
            # unconditionally, not only to a cold cursor — a cursor frozen at an
            # earlier reign is exactly as far behind as none at all, and without
            # the floor the next election replays every event since.
            #
            # The window is deliberately wider than the eligibility window, not
            # equal to it. A dead reporter keeps its document — and so its
            # eligibility — for PEER_FRESH_SECONDS after its last publish, so
            # the successor's first tick lands just *past* that mark: with one
            # constant for both, the opening event of the incident is aged out
            # by the few seconds of tick latency, which is the event that says
            # why. Doubling costs nothing; the case it clamps is hours old.
            ring = (doc or {}).get("events", []) or []
            if not isinstance(ring, list):
                ring = []
            fresh = [
                e.get("seq", 0)
                for e in ring
                if isinstance(e, dict) and now - e.get("ts", 0) <= FLOOR_SECONDS
            ]
            floor = (min(fresh) - 1) if fresh else (doc or {}).get("seq", 0)
            if node not in announced:
                announced[node] = {"seq": floor, "stale_ts": -1}
            cursor = announced[node]

            # A node corosync sees online whose document is missing or stale has
            # a dead or wedged watchdog — or a long pmxcfs stall, or it is
            # inquorate (publish fails there by design). The message claims only
            # what is known. Nothing else in the system can see this condition.
            doc_ts = doc.get("ts", 0) if doc else 0
            # Both incidents below carry doc_ts == 0: there is no document to
            # take a timestamp from either way. The timestamp alone cannot
            # latch them apart, so whichever fires first would suppress the
            # other permanently — neither path reaches the re-arm, which only
            # runs for a fresh readable document.
            kind = "unreadable" if node in unreadable else "silent"
            if online and now - doc_ts > PEER_FRESH_SECONDS:
                if (cursor["stale_ts"], cursor.get("stale_kind")) != (doc_ts, kind):
                    cursor["stale_ts"] = doc_ts
                    cursor["stale_kind"] = kind
                    # Two different incidents share this branch, and naming one
                    # as the other sends the operator hunting a dead unit or a
                    # stalled pmxcfs that does not exist: a node whose document
                    # was DROPPED is publishing fine, we just cannot read it.
                    if node in unreadable:
                        out.append(
                            (
                                "warning",
                                "watchdog unreadable",
                                node,
                                "%s is publishing a document this reporter cannot read — "
                                "a version mismatch or corruption, not a dead watchdog. "
                                "Its events are not announced until it publishes a "
                                "readable document again." % node,
                            )
                        )
                    else:
                        out.append(
                            (
                                "warning",
                                "watchdog silent",
                                node,
                                "%s is online in the cluster but its LAN watchdog has %s. The "
                                "node's LAN is unwatched until pve-lan-watchdog runs there "
                                "again — or the node is inquorate or pmxcfs is stalled, which "
                                "look identical from here."
                                % (
                                    node,
                                    (
                                        ("not published in %ds" % (now - doc_ts))
                                        if doc
                                        else "never published"
                                    ),
                                ),
                            )
                        )
                continue
            cursor["stale_ts"] = -1  # publishing again; a future stall re-alerts
            cursor["stale_kind"] = None

            # A node that left the cluster is HA's problem, and PVE sends its own
            # fencing notification; repeating it here would be noise.
            if not online or not doc:
                continue

            # max() below can only push a cursor forward, so it cannot help a
            # cursor that is too far *ahead*: a node whose /var/lib was lost
            # (reimage, or the `rm state.json` this script's --rearm exists to
            # replace) restarts its counter at zero, and every event it will
            # ever publish sorts below the high-water mark from its last life.
            # Silent and permanent — its document stays fresh and healthy, so
            # `watchdog silent` never fires either. A seq that went backwards
            # is proof of the state loss, and the same loss discards
            # owns_maintenance, so say so rather than only resyncing. Below the
            # offline gate on purpose: a reimaged node that then left the
            # cluster is fencing's story, and this message becomes actionable
            # when it returns and republishes.
            if doc.get("seq", 0) < cursor["seq"]:
                out.append(
                    (
                        "warning",
                        "watchdog state lost",
                        node,
                        "%s restarted its event counter at %d, below the %d already "
                        "reported: its local state was lost. Reporting resumes from "
                        "the restarted counter. If it was in HA maintenance it no "
                        "longer records owning it — check `ha-manager status`."
                        % (node, doc.get("seq", 0), cursor["seq"]),
                    )
                )
                cursor["seq"] = floor

            # Everything newer than the cursor AND the floor, oldest first, so a
            # burst of transitions between reads is announced completely and in
            # order. The gap check measures from the cursor, not the clamped
            # start: a live flap that outruns the ring must still be called out,
            # while a stale cursor skipping over old history must not be.
            start = max(cursor["seq"], floor)
            events = sorted(
                (e for e in ring if isinstance(e, dict) and e.get("seq", 0) > start),
                key=lambda e: e.get("seq", 0),
            )
            if events and cursor["seq"] and events[0].get("seq", 0) > cursor["seq"] + 1:
                missed = events[0].get("seq", 0) - cursor["seq"] - 1
                # Suppress only when the WHOLE skipped range is still retained
                # — i.e. it is old news a previous reign delivered. Testing
                # whether *any* of it survives hides a partial gap: a ring that
                # overflowed and then went quiet keeps its oldest retained
                # events past the window, and those alone silenced the report
                # of the ones that really aged out. The ring is contiguous, so
                # the whole range is retained exactly when cursor+1 is in it.
                retained = {e.get("seq") for e in ring if isinstance(e, dict)}
                if cursor["seq"] + 1 not in retained:
                    out.append(
                        (
                            "warning",
                            "events missed",
                            node,
                            "%s advanced from event %d to %d while unreported; %d event(s) "
                            "aged out of its document before any reporter announced them."
                            % (node, cursor["seq"], events[0].get("seq", 0), missed),
                        )
                    )
            for event in events:
                cursor["seq"] = event.get("seq", cursor["seq"])
                # name is the one peer-supplied value used as a dict key; an
                # unhashable one must land in _raw like every other event this
                # reporter cannot compose, not in the per-node except.
                name = event.get("name")
                render = _RENDERERS.get(name) if isinstance(name, str) else None
                if render is None:
                    out.append(_raw(node, event))
                    continue
                try:
                    severity, title, text = render(node, event.get("detail") or {})
                except Exception as err:  # a newer node changed this event's shape
                    log("err", "cannot render %s/%s: %s" % (node, event.get("name"), err))
                    out.append(_raw(node, event))
                    continue
                out.append((severity, title, node, text))
        except Exception as err:
            log("err", "reporter skipped %s: %s: %s" % (node, type(err).__name__, err))
            continue
    return out, announced


def reporter_tick(state):
    """Run the reporter half once. A cheap no-op on every node but the
    elected one. The announced cursor persists in local state so a restarted
    reporter does not replay history. A newly elected reporter announces
    whatever it has not itself announced, which after a handover may repeat
    the previous reporter's last message: duplicate beats silent."""
    docs, unreadable = read_peer_docs()
    if elect_reporter(docs) != NODE:
        return
    members = cluster_nodes()
    if not members:
        return
    cursors = state.get("announced", {})
    before = json.dumps(cursors, sort_keys=True)
    due, announced = report(docs, members, cursors, unreadable=unreadable)
    state["announced"] = announced
    for severity, title, node, text in due:
        log("info", "reporting for %s: %s" % (node, title))
        notify(severity, title, node, text)
    # Persisted after the sends: a crash mid-loop re-announces on restart
    # rather than losing what was never delivered — duplicate beats silent,
    # except for a notification that reports its own failure. notify() logs
    # rc != 0 and returns without rolling the cursor back, so a failed send
    # is lost permanently, not merely delayed: the cursor has already moved
    # past it, and nothing later replays it. Delivery is best-effort on
    # purpose; a per-node rollback on failed sends would close this gap if
    # it's ever worth the added complexity.
    #
    # A cursor that moved without producing a notification has to persist
    # too. The re-arm under a resolved stall is exactly that: it is what
    # lets the NEXT stall alert, and both no-document incidents latch on
    # the same (0, kind), so dropping it re-latches the next one out for
    # its whole duration. The unit restarts on every deploy of this role,
    # so a restarted reporter is routine, not an outage. Compared rather
    # than saved unconditionally: in steady state no cursor moves, so this
    # writes nothing.
    if due or json.dumps(announced, sort_keys=True) != before:
        save_state(state)


# --- rearm -----------------------------------------------------------------


def rearm():
    """Clear the flap counter only. Deleting the whole state file would also
    discard owns_maintenance, and nothing else records that we drained the
    node, so a drained node would sit in maintenance forever. Restarts the
    service so the running loop reloads rather than saving its stale copy
    back."""
    state = load_state()
    cleared = len(state.get("trips", []))
    state["trips"] = []
    if not save_state(state):
        log("err", "could not clear the flap counter; the guard is still armed")
        return 1
    rc, out = run(["systemctl", "restart", "pve-lan-watchdog"])
    if rc != 0:
        log("err", "state cleared but restart failed: %s" % out)
        return 1
    log(
        "info",
        "re-armed %s: cleared %d trip(s), phase=%s owns_maintenance=%s"
        % (NODE, cleared, state.get("phase"), state.get("owns_maintenance")),
    )
    return 0


# --- main loop -------------------------------------------------------------


class Stopped(Exception):
    pass


def _stop(signum, frame):
    raise Stopped()


def main():
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    if not PROBE_TARGETS:
        log("err", "no PROBE_TARGETS configured, refusing to run")
        return 1
    if MODE not in ("monitor", "drain"):
        log("err", "MODE must be monitor or drain, got %r" % MODE)
        return 1

    state = load_state()
    log(
        "info",
        "started in %s mode on %s, probing %s via %s every %ss"
        % (MODE, NODE, ",".join(PROBE_TARGETS), PROBE_INTERFACE, PROBE_INTERVAL),
    )
    if state.get("owns_maintenance"):
        log("warning", "resuming with %s still drained by a previous run" % NODE)

    fails = 0
    goods = 0
    bounces = 0
    healthy_since = None
    published_lan = None
    last_publish = 0.0
    last_nag = 0.0
    quorate = True

    while True:
        healthy = probe()
        now = time.time()

        if healthy:
            fails = 0
            goods += 1
            if healthy_since is None:
                healthy_since = now
        else:
            goods = 0
            fails += 1
            healthy_since = None

        # Transitions attach an event; the publish at the bottom of the loop
        # carries it into the shared document, where the reporter finds it.
        # Nothing in this loop sends a notification.
        pending_event = None

        phase = state["phase"]

        if phase == HEALTHY and healthy:
            bounces = 0

        elif phase == HEALTHY and fails >= FAIL_THRESHOLD:
            log(
                "warning",
                "LAN down: %d consecutive failed probes of %s" % (fails, ",".join(PROBE_TARGETS)),
            )
            state["phase"] = DEGRADED
            save_state(state)
            pending_event = ("lan_down", {"fails": fails, "targets": PROBE_TARGETS})

        elif phase == DEGRADED and healthy and goods >= RECOVER_THRESHOLD:
            log("warning", "LAN recovered after %d bounce(s), no drain needed" % bounces)
            state["phase"] = HEALTHY
            save_state(state)
            pending_event = ("recovered", {"bounces": bounces})
            bounces = 0

        # Still down. Re-confirm across the full threshold between escalations
        # so a bounce is followed by a real measurement, not an instant retry.
        elif phase == DEGRADED and fails >= FAIL_THRESHOLD:
            if BOUNCE_ENABLED and bounces < BOUNCE_ATTEMPTS:
                bounces += 1
                log("warning", "bounce attempt %d of %d" % (bounces, BOUNCE_ATTEMPTS))
                bounce()
                time.sleep(BOUNCE_SETTLE)
                fails = 0
                continue

            docs, _ = read_peer_docs()
            peers = healthy_peers(docs)
            trips = recent_trips(state)
            nagging = now - last_nag >= NAG_SECONDS

            if not quorate:
                if nagging:
                    log("err", "LAN down and inquorate; HA will handle this, standing by")
                    # The publish below fails while inquorate, so this event
                    # surfaces only if quorum returns with the LAN still dead.
                    pending_event = ("inquorate", {})
                    last_nag = now
            elif peers < DRAIN_MIN_HEALTHY_PEERS:
                if nagging:
                    log(
                        "warning",
                        "not draining: %d peer(s) report a healthy LAN, need %d. "
                        "Looks LAN-wide rather than local to %s."
                        % (peers, DRAIN_MIN_HEALTHY_PEERS, NODE),
                    )
                    pending_event = (
                        "refused_lan_wide",
                        {"healthy_peers": peers, "needed": DRAIN_MIN_HEALTHY_PEERS},
                    )
                    last_nag = now
            elif trips >= FLAP_MAX_TRIPS:
                if nagging:
                    log(
                        "err",
                        "refusing to drain %s: %d trips already in the last %ds. "
                        "Run `pve-lan-watchdog --rearm` after fixing the NIC; the "
                        "guard also clears itself once the trips age out."
                        % (NODE, trips, FLAP_WINDOW_SECONDS),
                    )
                    pending_event = (
                        "refused_flapping",
                        {"trips_in_window": trips, "window": FLAP_WINDOW_SECONDS},
                    )
                    last_nag = now
            elif MODE != "drain":
                if nagging:
                    log(
                        "warning",
                        "would drain %s now (%d healthy peer(s)) but MODE is %s"
                        % (NODE, peers, MODE),
                    )
                    pending_event = ("would_drain", {"healthy_peers": peers})
                    last_nag = now
            elif set_maintenance(True):
                state["phase"] = DRAINED
                state["owns_maintenance"] = True
                state["trips"].append(int(now))
                # state.json is on /var/lib and the published document is on
                # /etc/pve — different filesystems, so a failed local write
                # can still be reported through the working channel. The
                # in-memory state stays correct; the danger is a restart
                # forgetting we own the maintenance, which the event warns
                # a human about with the exact recovery command.
                persisted = save_state(state)
                pending_event = (
                    "drained",
                    {
                        "bounces": bounces,
                        "stable_seconds": DRAIN_STABLE_SECONDS,
                        "persisted": persisted,
                    },
                )

        # Drained. Come back only after a long clean stretch: leaving
        # maintenance migrates the guests straight back, so a flap costs two
        # live migrations.
        elif phase == DRAINED and healthy and goods >= RECOVER_THRESHOLD:
            stable = now - (healthy_since or now)
            if stable >= DRAIN_STABLE_SECONDS and set_maintenance(False):
                log("warning", "LAN clean for %ds, %s back in service" % (stable, NODE))
                state["phase"] = HEALTHY
                state["owns_maintenance"] = False
                save_state(state)
                pending_event = (
                    "back_in_service",
                    {"stable": int(stable), "trips_in_window": recent_trips(state)},
                )
                bounces = 0

        if (
            pending_event is not None
            or healthy != published_lan
            or now - last_publish >= PEER_KEEPALIVE_SECONDS
        ):
            quorate = publish(state, healthy, pending_event)
            if quorate:
                published_lan, last_publish = healthy, now
                if pending_event is not None:
                    save_state(state)  # seq and last_event advanced

        try:
            reporter_tick(state)
        except Exception as err:  # never let the reporting half stop the acting half
            log("err", "reporter tick failed: %s: %s" % (type(err).__name__, err))

        time.sleep(PROBE_INTERVAL)


if __name__ == "__main__":
    # Only systemd starts the loop. Anything else on the command line is a
    # typo, and falling through would run a second watchdog beside the unit,
    # sharing the state file and free to bounce the NIC on a node set to
    # drain.
    args = sys.argv[1:]
    if args == ["--rearm"]:
        sys.exit(rearm())
    if args:
        print("usage: pve-lan-watchdog [--rearm]", file=sys.stderr)
        sys.exit(2)
    try:
        sys.exit(main())
    except Stopped:
        log("info", "stopping on signal; leaving maintenance state as-is")
        sys.exit(0)
