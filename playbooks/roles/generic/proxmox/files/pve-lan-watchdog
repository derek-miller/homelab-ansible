#!/usr/bin/env python3
"""Watch the LAN link, get HA resources off a node whose LAN dies, and report
the whole fleet's LAN health from a node that can actually deliver a message.

Proxmox HA relocates on loss of quorum plus watchdog expiry. It watches node
liveness, not service reachability. A node whose LAN NIC wedges its TX ring
keeps quorum over the corosync fabric ring, so HA sees a healthy node while
everything bridged to vmbr0 is dark. Officially acknowledged and unhandled
(Bugzilla #7354); maintenance-mode evacuation is one of the two approaches the
PVE developers suggest, and the one that live-migrates instead of fencing.

The watchdog is two independent halves joined only by a published state
document in /etc/pve/lan-watchdog/<node>, which pmxcfs replicates over
corosync and therefore over the fabric — the one channel that survives
exactly the failure being diagnosed.

LOCAL half (every node): probe -> bounce -> drain, all strictly about this
node, escalating cheapest-first:

  1. probe   several LAN targets, not just the gateway, so a gateway reboot
             cannot trip anything
  2. bounce  ip link down/up on the LAN NIC: local, seconds, and what actually
             cleared the 2026-07-31 e1000e TX hang
  3. drain   ha-manager node-maintenance, live-migrating HA resources off over
             the fabric — gated on peers reporting a healthy LAN, so a
             switch-wide failure drains nobody

The local half NEVER notifies. A node whose LAN is down cannot reach the
notification target (it egresses over vmbr0), so a self-reporting design
loses precisely the messages that matter. Instead every transition is written
into the published document as a monotonically sequenced event.

REPORTER half (every node runs it; at most one acts): reads every peer's
document plus corosync's own membership view (/etc/pve/.members) and sends
notifications on the whole fleet's behalf. The reporter is the lowest-sorted
node currently publishing a fresh healthy document — eligibility is exactly
the capability the job needs, so failover is automatic: a reporter whose LAN
dies publishes 'down' and disqualifies itself, and the next healthy node
takes over on its next tick. No lock, no lease; every node computes the same
answer from the same replicated data. Brief double-sends during a handover
are possible and accepted; deduplicating would need writable shared state,
which costs more than a repeated alert.

Reporting is by sequence number, not by current state, so a fault that
bounces clean between reporter ticks is still reported afterwards rather
than lost. The reporter also flags a node that corosync says is online but
whose document has gone stale — a dead or wedged watchdog, which nothing
else in the system can see.
"""

import json
import os
import signal
import subprocess
import sys
import time

# --- configuration, supplied by the systemd EnvironmentFile ----------------


def _env(name, default):
    value = os.environ.get(name, "").strip()
    return value if value else default


def _int(name, default):
    try:
        return int(_env(name, str(default)))
    except ValueError:
        return default


def _bool(name, default):
    return _env(name, "yes" if default else "no").lower() in ("yes", "true", "1", "on")


MODE = _env("MODE", "monitor")  # monitor | drain
NODE = _env("NODE", os.uname().nodename)
LAN_INTERFACE = _env("LAN_INTERFACE", "nic0")
PROBE_INTERFACE = _env("PROBE_INTERFACE", "vmbr0")
PROBE_TARGETS = _env("PROBE_TARGETS", "").split()
PROBE_INTERVAL = _int("PROBE_INTERVAL", 5)
PROBE_TIMEOUT = _int("PROBE_TIMEOUT", 2)

FAIL_THRESHOLD = _int("FAIL_THRESHOLD", 6)
RECOVER_THRESHOLD = _int("RECOVER_THRESHOLD", 3)

BOUNCE_ENABLED = _bool("BOUNCE_ENABLED", True)
BOUNCE_ATTEMPTS = _int("BOUNCE_ATTEMPTS", 2)
BOUNCE_SETTLE = _int("BOUNCE_SETTLE", 15)

NOTIFY_ENABLED = _bool("NOTIFY_ENABLED", True)
NOTIFY_TEMPLATE = _env("NOTIFY_TEMPLATE", "lan-watchdog")

PEER_DIR = _env("PEER_DIR", "/etc/pve/lan-watchdog")
MEMBERS_FILE = _env("MEMBERS_FILE", "/etc/pve/.members")
PEER_FRESH_SECONDS = _int("PEER_FRESH_SECONDS", 180)
# How far back a reporter with no usable cursor treats events as already
# announced. Strictly wider than PEER_FRESH_SECONDS — see report() — and the
# max() holds that invariant against an env override, since a floor at or
# under the eligibility window silently clamps a handover's opening event.
FLOOR_SECONDS = max(_int("FLOOR_SECONDS", PEER_FRESH_SECONDS * 2), PEER_FRESH_SECONDS * 2)
PEER_KEEPALIVE_SECONDS = _int("PEER_KEEPALIVE_SECONDS", 60)
DRAIN_MIN_HEALTHY_PEERS = _int("DRAIN_MIN_HEALTHY_PEERS", 1)
DRAIN_STABLE_SECONDS = _int("DRAIN_STABLE_SECONDS", 600)

FLAP_WINDOW_SECONDS = _int("FLAP_WINDOW_SECONDS", 21600)
FLAP_MAX_TRIPS = _int("FLAP_MAX_TRIPS", 2)

# Events kept in the published document. The reporter announces everything
# newer than its cursor, so this is how much lag or reporter downtime can pass
# before history is lost. 16 events at ~200 bytes is ~3KB, far under pmxcfs
# file limits, and 16 transitions with no working reporter means something
# much bigger is wrong.
DOC_EVENTS_KEPT = _int("DOC_EVENTS_KEPT", 16)

STATE_DIR = _env("STATE_DIR", "/var/lib/pve-lan-watchdog")
STATE_FILE = os.path.join(STATE_DIR, "state.json")

# How often a still-down node repeats its refusal event, so a long outage is
# re-announced occasionally rather than every probe interval or only once.
NAG_SECONDS = _int("NAG_SECONDS", 300)

HEALTHY, DEGRADED, DRAINED = "healthy", "degraded", "drained"

DOC_VERSION = 1


def log(level, message):
    print("%s: %s" % (level, message), flush=True)


# --- shelling out ----------------------------------------------------------


def run(argv, timeout=30):
    """Return (rc, stdout). Never raises; a timeout or missing binary is rc 1."""
    try:
        done = subprocess.run(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            text=True,
        )
        return done.returncode, done.stdout.strip()
    except subprocess.TimeoutExpired:
        return 1, "timed out after %ss" % timeout
    except OSError as err:
        return 1, str(err)


def probe():
    """True if any LAN target answers. A dead NIC fails all of them; a single
    dead peer, or a gateway mid-reboot, fails only its own."""
    for target in PROBE_TARGETS:
        rc, _ = run(
            [
                "ping",
                "-n",
                "-q",
                "-c",
                "1",
                "-W",
                str(PROBE_TIMEOUT),
                "-I",
                PROBE_INTERFACE,
                target,
            ],
            timeout=PROBE_TIMEOUT + 3,
        )
        if rc == 0:
            return True
    return False


def bounce():
    log("info", "bouncing %s" % LAN_INTERFACE)
    for action in ("down", "up"):
        rc, out = run(["ip", "link", "set", LAN_INTERFACE, action])
        if rc != 0:
            log("err", "ip link set %s %s failed: %s" % (LAN_INTERFACE, action, out))
            return False
    return True


def set_maintenance(enabled):
    action = "enable" if enabled else "disable"
    rc, out = run(["ha-manager", "crm-command", "node-maintenance", action, NODE])
    if rc != 0:
        log("err", "node-maintenance %s failed: %s" % (action, out))
        return False
    log("warning", "node-maintenance %s requested for %s" % (action, NODE))
    return True


# --- local state -----------------------------------------------------------


def load_state():
    try:
        with open(STATE_FILE) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {"phase": HEALTHY, "owns_maintenance": False, "trips": [], "seq": 0}


def save_state(state):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as handle:
            json.dump(state, handle)
        os.replace(tmp, STATE_FILE)
        return True
    except OSError as err:
        log("err", "could not persist state: %s" % err)
        return False


def recent_trips(state):
    cutoff = int(time.time()) - FLAP_WINDOW_SECONDS
    state["trips"] = [t for t in state.get("trips", []) if t >= cutoff]
    return len(state["trips"])


# --- the published document ------------------------------------------------
#
# The sole interface between the two halves, and between nodes. The local
# half owns writing its own; the reporter half reads everyone's. `seq`
# increments once per event and `events` keeps the last DOC_EVENTS_KEPT of
# them, so a reporter that was slow, restarted, or freshly elected announces
# every event it has not yet announced rather than only the latest — two
# transitions between reporter reads lose nothing. `detail` is structured
# data, not prose: the reporter owns the wording, so messages can improve
# without touching every node's local half.


def publish(state, lan_healthy, event=None):
    """Write this node's document. /etc/pve goes read-only when the node is
    inquorate, so a failed write doubles as the quorum check: False means
    inquorate (or pmxcfs is wedged), and the caller must not drain, because
    HA is already handling a node in that condition."""
    if event is not None:
        state["seq"] = state.get("seq", 0) + 1
        state.setdefault("events", []).append(
            {
                "seq": state["seq"],
                "ts": int(time.time()),
                "name": event[0],
                "detail": event[1],
            }
        )
        state["events"] = state["events"][-DOC_EVENTS_KEPT:]
    doc = {
        "v": DOC_VERSION,
        "node": NODE,
        "ts": int(time.time()),
        "seq": state.get("seq", 0),
        "lan": "healthy" if lan_healthy else "down",
        "phase": state.get("phase", HEALTHY),
        "mode": MODE,
        "events": state.get("events", []),
    }
    try:
        os.makedirs(PEER_DIR, exist_ok=True)
        tmp = os.path.join(PEER_DIR, ".%s.tmp" % NODE)
        with open(tmp, "w") as handle:
            json.dump(doc, handle)
        os.replace(tmp, os.path.join(PEER_DIR, NODE))
        return True
    except OSError as err:
        _throttled_publish_warning(err)
        return False


_last_publish_warning = [0.0]


def _throttled_publish_warning(err):
    now = time.time()
    if now - _last_publish_warning[0] >= NAG_SECONDS:
        log("warning", "could not publish to %s: %s" % (PEER_DIR, err))
        _last_publish_warning[0] = now


def read_peer_docs():
    """Every node's published document, keyed by node name, plus the set of
    nodes that ARE publishing but whose document cannot be read. The two are
    different incidents — a dead watchdog versus a version mismatch — and
    announcing one as the other sends the operator hunting for a stalled
    pmxcfs that does not exist. Tolerates the v0 format ('<ts>
    <healthy|down>') from nodes not yet upgraded: those become minimal
    documents with no event history, which the reporter treats as
    state-only."""
    docs = {}
    unreadable = set()
    try:
        names = os.listdir(PEER_DIR)
    except OSError:
        return docs, unreadable
    for name in names:
        if name.startswith("."):
            continue
        try:
            with open(os.path.join(PEER_DIR, name)) as handle:
                raw = handle.read()
        except OSError as err:
            # The name came from listdir, so the node IS publishing something;
            # we just could not read the file. Same incident as an unreadable
            # parse, so it joins the same set rather than being announced as
            # if the node had never published at all.
            log("err", "could not read document from %s: %s" % (name, err))
            unreadable.add(name)
            continue
        try:
            doc = json.loads(raw)
            if isinstance(doc, dict) and "ts" in doc:
                # This is the trust boundary: everything downstream — the
                # election, the drain gate, the reporter — does arithmetic on
                # these three. Coerce them here, once, rather than guarding
                # five call sites, and drop a document whose scalars a newer
                # node changed the type of. A dropped document is not silence:
                # the node joins `unreadable` and is announced through
                # `watchdog unreadable`, distinct from a node that genuinely
                # never published (`watchdog silent`) — see report().
                try:
                    doc["ts"] = int(doc["ts"])  # presence is the branch condition
                    for key in ("seq", "v"):
                        doc[key] = int(doc.get(key, 0))
                    # A wrong container type is as unreadable as a wrong scalar
                    # type: kept-but-mute would be the silent-and-permanent
                    # failure the drop-and-announce contract exists to prevent.
                    if not isinstance(doc.get("events", []), list):
                        raise TypeError("events is not a list")
                    # The ring's scalars cross the same boundary, and report()
                    # does the same arithmetic on them once per event.
                    for event in doc.get("events") or []:
                        if isinstance(event, dict):
                            for key in ("ts", "seq"):
                                if key in event:
                                    event[key] = int(event[key])
                except (TypeError, ValueError):
                    log("err", "ignoring unreadable document from %s" % name)
                    unreadable.add(name)
                    continue
                docs[name] = doc
                continue
        except ValueError:
            pass
        try:  # v0 fallback
            stamp, lan = raw.split()[:2]
            docs[name] = {"v": 0, "node": name, "ts": int(stamp), "seq": 0, "lan": lan}
        except (ValueError, IndexError):
            unreadable.add(name)
            continue
    return docs, unreadable


def cluster_nodes():
    """Corosync's own membership view: {node: online_bool}. This, not a
    directory listing, is the expected-node list — a node whose document was
    never created is invisible in a listing, and noticing that absence is the
    point."""
    try:
        with open(MEMBERS_FILE) as handle:
            members = json.load(handle)
        return {
            name: bool(info.get("online")) for name, info in members.get("nodelist", {}).items()
        }
    except (OSError, ValueError):
        return {}


def healthy_peers(docs=None):
    """Count of OTHER nodes publishing a fresh healthy document. Gates the
    drain: zero healthy peers means the fault looks LAN-wide, and draining
    onto an equally dark node helps nobody."""
    docs = docs if docs is not None else read_peer_docs()[0]
    now = int(time.time())
    return sum(
        1
        for name, doc in docs.items()
        if name != NODE
        and doc.get("lan") == "healthy"
        and now - doc.get("ts", 0) <= PEER_FRESH_SECONDS
    )


# --- reporter half ---------------------------------------------------------


def elect_reporter(docs, now=None):
    """The lowest-sorted node publishing a fresh healthy document. A pure
    function of replicated data, so every node computes the same answer
    without coordinating. Eligibility is exactly the capability the job
    needs — a working LAN — so a reporter that goes dark disqualifies itself
    and the next node takes over with no handoff protocol."""
    now = int(now if now is not None else time.time())
    eligible = [
        name
        for name, doc in docs.items()
        # A working LAN is one required capability; carrying the reporter
        # code (v1+) is the other. A v0 node that won would silence everyone.
        if doc.get("v", 0) >= 1
        and doc.get("lan") == "healthy"
        and now - doc.get("ts", 0) <= PEER_FRESH_SECONDS
    ]
    return min(eligible) if eligible else None


# Message composition lives entirely on the reporter, keyed by event name.
# severity 'warning' is routed by the cluster's critical matcher, 'notice' by
# the non-critical one. Unknown event names (from a newer node) are reported
# raw rather than dropped.


def _fmt_targets(detail):
    return ", ".join(detail.get("targets", [])) or "its probe targets"


_RENDERERS = {
    "lan_down": lambda n, d: (
        "warning",
        "LAN down",
        "%s failed %d consecutive probes of %s and is escalating."
        % (n, d.get("fails", 0), _fmt_targets(d)),
    ),
    "recovered": lambda n, d: (
        "notice",
        "LAN recovered",
        "%s recovered after %d bounce(s). No drain was needed." % (n, d.get("bounces", 0)),
