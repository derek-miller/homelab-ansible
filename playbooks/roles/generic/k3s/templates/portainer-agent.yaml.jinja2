apiVersion: v1
kind: Namespace
metadata:
  name: portainer
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: portainer-sa-clusteradmin
  namespace: portainer
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: portainer-crb-clusteradmin
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
  - kind: ServiceAccount
    name: portainer-sa-clusteradmin
    namespace: portainer
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: portainer-agent-edge
  namespace: portainer
data:
  EDGE_ID: {{ k3s_portainer_edge_id | to_json }}
  EDGE_INSECURE_POLL: "1"
---
apiVersion: v1
kind: Secret
metadata:
  name: portainer-agent-edge-key
  namespace: portainer
type: Opaque
stringData:
  edge.key: {{ k3s_portainer_edge_key | to_json }}
---
apiVersion: v1
kind: Service
metadata:
  name: portainer-agent
  namespace: portainer
spec:
  clusterIP: None
  selector:
    app: portainer-agent
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: portainer-agent
  namespace: portainer
spec:
  selector:
    matchLabels:
      app: portainer-agent
  template:
    metadata:
      labels:
        app: portainer-agent
      annotations:
        checksum/edge-credentials: {{ (k3s_portainer_edge_id ~ '/' ~ k3s_portainer_edge_key) | hash('sha256') | to_json }}
    spec:
      serviceAccountName: portainer-sa-clusteradmin
      containers:
        - name: portainer-agent
          image: {{ _k3s_portainer_agent_image | to_json }}
          imagePullPolicy: Always
          env:
            - name: LOG_LEVEL
              value: INFO
            - name: KUBERNETES_POD_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.podIP
            - name: EDGE
              value: "1"
            - name: AGENT_CLUSTER_ADDR
              value: portainer-agent
            - name: EDGE_KEY
              valueFrom:
                secretKeyRef:
                  name: portainer-agent-edge-key
                  key: edge.key
          envFrom:
            - configMapRef:
                name: portainer-agent-edge
          ports:
            - containerPort: 9001
              protocol: TCP
            - containerPort: 80
              protocol: TCP
