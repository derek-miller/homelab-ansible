---
apiVersion: v1
kind: Secret
metadata:
  name: zot-credentials
  namespace: flux-system
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: {{ {'auths': {_flux_registry_cluster_address: {'auth': _flux_registry_auth}}} | to_json | to_json }}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  name: apps
  namespace: flux-system
spec:
  interval: 10m
  url: oci://{{ _flux_registry_cluster_address }}/apps
  ref:
    tag: latest
  insecure: true
  secretRef:
    name: zot-credentials
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: apps
  namespace: flux-system
spec:
  interval: 10m
  sourceRef:
    kind: OCIRepository
    name: apps
  path: ./
  prune: true
  wait: true
  timeout: {{ flux_apply_timeout | to_json }}
  postBuild:
    substitute:
{% for label, node in _flux_label_nodes | dictsort %}
      node_{{ label }}: {{ node | to_json }}
{% endfor %}
