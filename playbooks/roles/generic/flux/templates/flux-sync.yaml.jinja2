---
apiVersion: v1
kind: Secret
metadata:
  name: zot-credentials
  namespace: flux-system
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: {{ {'auths': {_flux_registry_cluster_address: {'auth': _flux_registry_auth}}} | to_json | to_json }}
---
# The add-ons in platform/, such as operators whose CRDs the apps use, apply first.
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  name: platform
  namespace: flux-system
spec:
  interval: 10m
  url: oci://{{ _flux_registry_cluster_address }}/apps
  ref:
    tag: latest
  insecure: true
  secretRef:
    name: zot-credentials
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: platform
  namespace: flux-system
spec:
  interval: 10m
  sourceRef:
    kind: OCIRepository
    name: platform
  path: ./platform
  prune: true
  wait: true
  timeout: {{ flux_apply_timeout | to_json }}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  name: apps
  namespace: flux-system
spec:
  interval: 10m
  url: oci://{{ _flux_registry_cluster_address }}/apps
  ref:
    tag: latest
  ignore: /platform/
  insecure: true
  secretRef:
    name: zot-credentials
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: apps
  namespace: flux-system
spec:
  interval: 10m
  dependsOn:
    - name: platform
  sourceRef:
    kind: OCIRepository
    name: apps
  path: ./
  prune: true
  wait: true
  timeout: {{ flux_apply_timeout | to_json }}
  healthCheckExprs:
    # local-retain binds a claim only once a pod is placed on it, so a claim only a CronJob uses waits for its first run.
    - apiVersion: v1
      kind: PersistentVolumeClaim
      current: >-
        status.phase == 'Bound' || (status.phase == 'Pending'
        && !(has(metadata.annotations) && 'volume.kubernetes.io/selected-node' in metadata.annotations))
