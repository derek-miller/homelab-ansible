---
apiVersion: fluxcd.controlplane.io/v1
kind: FluxInstance
metadata:
  name: flux
  namespace: flux-system
spec:
  distribution:
    version: {{ flux_distribution_version | string | to_json }}
    registry: ghcr.io/fluxcd
  components:
    - source-controller
    - kustomize-controller
    - helm-controller
    - notification-controller
  cluster:
    type: kubernetes
    networkPolicy: true
---
apiVersion: v1
kind: Service
metadata:
  name: flux-web
  namespace: flux-system
spec:
  selector:
    app.kubernetes.io/instance: flux-operator
    app.kubernetes.io/name: flux-operator
  ports:
    - port: 9080
      targetPort: 9080
---
# A built-in Ingress, not a Traefik IngressRoute, so this applies before Flux has installed Traefik's CRDs.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: flux-web
  namespace: flux-system
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
spec:
  rules:
    - host: {{ flux_web_base_url | urlsplit('hostname') | to_json }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: flux-web
                port:
                  number: 9080
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-edge-traefik
  namespace: flux-system
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/instance: flux-operator
      app.kubernetes.io/name: flux-operator
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: edge
          podSelector:
            matchLabels:
              app.kubernetes.io/name: traefik
      ports:
        - protocol: TCP
          port: 9080
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: flux-web-admin
subjects:
  - kind: User
    name: {{ flux_web_admin | to_json }}
    apiGroup: rbac.authorization.k8s.io
roleRef:
  kind: ClusterRole
  name: flux-web-admin
  apiGroup: rbac.authorization.k8s.io
