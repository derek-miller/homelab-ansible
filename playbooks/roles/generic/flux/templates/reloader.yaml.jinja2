---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: reloader
  namespace: kube-system
spec:
  repo: https://stakater.github.io/stakater-charts
  chart: reloader
  version: {{ reloader_chart_version | string | to_json }}
  targetNamespace: reloader
  createNamespace: true
  valuesContent: |-
    reloader:
      autoReloadAll: true
      reloadStrategy: annotations
      # k3s rewrites CoreDNS's ConfigMap whenever a node changes.
      ignoreNamespaces: kube-system
