---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: reloader
  namespace: kube-system
spec:
  chart: oci://ghcr.io/{{ _flux_charts.reloader.repo }}
  version: {{ _flux_chart_releases.reloader | to_json }}
  targetNamespace: reloader
  createNamespace: true
  valuesContent: |-
    reloader:
      autoReloadAll: true
      reloadStrategy: annotations
      # k3s rewrites CoreDNS's ConfigMap whenever a node changes.
      ignoreNamespaces: kube-system
